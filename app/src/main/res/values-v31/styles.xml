<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:ns0="http://schemas.android.com/tools">
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode" ns0:targetApi="28">shortEdges</item>
        <item name="android:enforceStatusBarContrast" ns0:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" ns0:targetApi="29">false</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background_top</item>
        <!-- Not the splash colour itself: the icon themes below (windowSplashScreenAnimatedIcon)
             would then be drawn 1.2x larger (192dp). Not drawn behind an adaptive icon (colors.xml). -->
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launch_icon_ground</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_icon_none</item>
    </style>
    <style name="LaunchTheme.Mist">
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
    <style name="LaunchTheme.Night">
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_night</item>
    </style>
    <style name="LaunchTheme.Frost">
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_frost</item>
    </style>
    <style name="LaunchTheme.Ink">
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_ink</item>
    </style>
    <style name="LaunchTheme.White">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/white</item>
    </style>
    <style name="LaunchTheme.Black">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/black</item>
    </style>
</resources>
